{
    "input_file": "data\\02_noct_vs_pvwatts_santiago.csv",
    "output_dir": "outputs\\04_modelo_hibrido_xgboost_santiago",
    "target": "epsilon",
    "features_base": [
        "poa",
        "temperature",
        "wind_speed",
        "hour_sin",
        "hour_cos",
        "month_sin",
        "month_cos"
    ],
    "features_with_fd": [
        "poa",
        "temperature",
        "wind_speed",
        "hour_sin",
        "hour_cos",
        "month_sin",
        "month_cos",
        "fd"
    ],
    "test_fraction": 0.25,
    "split_type": "chronological_holdout_last_fraction",
    "p_ref_min_relative_error": 50.0,
    "xgboost_params": {
        "objective": "reg:squarederror",
        "n_estimators": 350,
        "max_depth": 3,
        "learning_rate": 0.035,
        "subsample": 0.85,
        "colsample_bytree": 0.85,
        "min_child_weight": 3,
        "reg_lambda": 2.0,
        "random_state": 42,
        "n_jobs": -1
    },
    "notes": [
        "El modelo aprende el residuo epsilon = P_ref - P_NOCT.",
        "El modelo sin fd evita DHI, DNI y GHI para no reconstruir implicitamente la fraccion difusa.",
        "La evaluacion principal usa separacion temporal, no aleatoria.",
        "Las importancias de variables son diagnosticas y no constituyen evidencia causal."
    ]
}